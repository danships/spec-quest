{
  "name": "spec-quest",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter spec-quest-mcp dev",
    "dev:server": "pnpm --filter @spec-quest/server dev",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "eslint-plugin-unicorn": "^65.0.1",
    "prettier": "^3.9.4",
    "typescript-eslint": "^8.62.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "short-uuid@4.2.2>uuid": "^11.1.1"
    }
  }
}
